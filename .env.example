# ── Docker image ──────────────────────────────────────────────────────────────
# Used by docker-compose.yml (pull from registry)
APP_IMAGE=ghcr.io/paperized/quiz-gpt:latest

# ── Server ────────────────────────────────────────────────────────────────────
# Public-facing URL of the app (used for CORS and internal links)
PUBLIC_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=quizgpt
POSTGRES_PASSWORD=changeme
POSTGRES_DB=quizgpt
# Composed from the fields above — change only if using an external DB
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ── LLM ───────────────────────────────────────────────────────────────────────
# API style: openai | anthropic | openai_compatible
LLM_API_STYLE=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://api.openai.com/v1       # default for openai; set for openai_compatible/anthropic

# ── Settings encryption ────────────────────────────────────────────────────────
# IMPORTANT: change this before deploying. Generate a new one with:
#   openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=c26b62778aadd0e4b233e9d0e5099f0a4303543ce10482ad9acfe9361b0cf924

# ── JWT secret ─────────────────────────────────────────────────────────────────
# Auto-generated on first start if not set. Set this to persist sessions across
# restarts. Generate with: openssl rand -hex 64
JWT_SECRET=

# ── Optional: GitHub integration ──────────────────────────────────────────────
# GITHUB_TOKEN=

# ── Advanced: Embeddings ──────────────────────────────────────────────────────
# EMBEDDING_API_STYLE=same_as_llm
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BATCH_SIZE=64
# MAX_EMBEDDING_CANDIDATES=220

# ── Advanced: Retrieval budgets ───────────────────────────────────────────────
# MAX_RETRIEVED_CHUNKS=16
# MAX_RETRIEVED_CHARS=28000

# ── Advanced: Rate limiting ───────────────────────────────────────────────────
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=0
# GENERATE_RATE_LIMIT_MAX_REQUESTS=0
# MULTI_SELECT_PENALTY_ALPHA=1

# ── Advanced: Server ──────────────────────────────────────────────────────────
# PORT=3000
# LOG_LEVEL=info
# LLM_MAX_TOKENS=2000
# LLM_TEMPERATURE=0.7
# ANTHROPIC_VERSION=2023-06-01
