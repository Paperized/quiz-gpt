# ── Docker image ──────────────────────────────────────────────────────────────
# Used by docker-compose.yml (pull from registry)
APP_IMAGE=ghcr.io/paperized/quiz-gpt:latest

# ── Server ────────────────────────────────────────────────────────────────────
# Public-facing URL of the app (used for CORS and internal links)
PUBLIC_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=quizgpt
POSTGRES_PASSWORD=changeme
POSTGRES_DB=quizgpt
# Composed from the fields above — change only if using an external DB
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ── Settings encryption ────────────────────────────────────────────────────────
# IMPORTANT: change this before deploying. Generate a new one with:
#   openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=c26b62778aadd0e4b233e9d0e5099f0a4303543ce10482ad9acfe9361b0cf924

# ── JWT secret ─────────────────────────────────────────────────────────────────
# Auto-generated on first start if not set. Set this to persist sessions across
# restarts. Generate with: openssl rand -hex 64
JWT_SECRET=

# ── Optional: GitHub integration ──────────────────────────────────────────────
# GITHUB_TOKEN=

# ── Advanced: Rate limiting ───────────────────────────────────────────────────
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=0
# GENERATE_RATE_LIMIT_MAX_REQUESTS=0
# MULTI_SELECT_PENALTY_ALPHA=1

# ── Advanced: Server ──────────────────────────────────────────────────────────
# PORT=3000
# LOG_LEVEL=info
