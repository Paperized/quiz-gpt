# Container image used by docker-compose.yml (registry mode)
APP_IMAGE=ghcr.io/paperized/quiz-gpt:latest
# Optional tag for docker-compose.dev.yml (local build mode)
APP_IMAGE_DEV=learn-gpt:dev

# Server
PORT=3000
PUBLIC_URL=http://localhost:3000

# Database (used by db container and app DATABASE_URL in Docker)
POSTGRES_USER=learngpt
POSTGRES_PASSWORD=learngpt
POSTGRES_DB=learngpt
DATABASE_URL=postgresql://learngpt:learngpt@db:5432/learngpt

# LLM
LLM_API_STYLE=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7
ANTHROPIC_VERSION=2023-06-01

# Embeddings retrieval
EMBEDDING_API_STYLE=same_as_llm
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
MAX_EMBEDDING_CANDIDATES=220
EMBEDDING_BATCH_SIZE=64

# Optional integrations
GITHUB_TOKEN=

# Retrieval budgets
MAX_RETRIEVED_CHUNKS=16
MAX_RETRIEVED_CHARS=28000
